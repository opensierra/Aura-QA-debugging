{
  "theme": "blender-dark",
  "accent": "#4a90e2",
  "sidebarMode": "collapsed",
  "compact": false,
  "animations": true,
  "uiLanguage": "en",
  "psdnsEnabled": true,
  "pipeline": {
    "filterT": [
      "com.android.deskclock",
      "com.vivo.calculator",
      "com.vivo.feedback",
      "com.vivo.imanager",
      "com.android.filemanager",
      "com.bbk.theme",
      "com.vivo.compass",
      "com.vivo.simplelauncher",
      "com.vivo.gallery",
      "com.android.bbkmusic",
      "com.vivo.exhealth",
      "com.vivo.easyshare",
      "com.android.camera",
      "com.vivo.soundrecorder",
      "com.vivo.weather",
      "com.android.settings",
      "com.vivo.Tips",
      "com.vivo.notes",
      "com.vivo.website.gdpr"
    ],
    "filterE": [
      "com.android.bbk.lockscreen3"
    ],
    "pairSource": "es",
    "pairTarget": "es",
    "maxDepth": 2,
    "maxScroll": 15,
    "speedFactor": 1,
    "similarityThreshold": 0.85,
    "ghostThreshold": 0.95,
    "maxBack": 2,
    "maxRelaunch": 2,
    "marginTop": 0.3,
    "marginBottom": 0.1,
    "marginLeft": 0.2,
    "marginRight": 0.2,
    "duration": 0.3,
    "sleepStable": 0.7,
    "sleepBack": 0.3,
    "sleepExit": 0.1,
    "sleepStart": 1,
    "enableCapture": true,
    "rootName": "0",
    "docOrientation": false,
    "docUnwarping": false,
    "textlineOrientation": false,
    "bcHost": "127.0.0.1",
    "bcPort": 0,
    "bcTimeout": 120,
    "qaPasses": 1
  }
}