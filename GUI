    def _resolve_in_project(self, rel):
        if not self._project or not rel:
            return None
        base = os.path.realpath(self._project)
        p = os.path.realpath(os.path.join(base, str(rel).replace("/", os.sep)))
        try:
            if os.path.commonpath([base, p]) != base:
                return None
        except ValueError:
            return None
        return p if os.path.isfile(p) else None

    def getImageData(self, relPath, maxWidth=0):
        import base64
        abs_path = self._resolve_in_project(relPath)
        if not abs_path:
            return None
        try:
            maxWidth = int(maxWidth or 0)
            if maxWidth > 0:
                key = (abs_path, os.path.getmtime(abs_path), maxWidth)
                hit = self._thumb_cache.get(key)
                if hit:
                    return hit
                try:
                    import io
                    from PIL import Image as PILImage
                    with PILImage.open(abs_path) as im:
                        im = im.convert("RGB")
                        if im.width > maxWidth:
                            im = im.resize((maxWidth, max(1, int(im.height * maxWidth / im.width))), PILImage.LANCZOS)
                        buf = io.BytesIO()
                        im.save(buf, format="JPEG", quality=80)
                    data = "data:image/jpeg;base64," + base64.b64encode(buf.getvalue()).decode("ascii")
                    if len(self._thumb_cache) > 400:
                        self._thumb_cache.clear()
                    self._thumb_cache[key] = data
                    return data
                except Exception:
                    pass
            ext = os.path.splitext(abs_path)[1].lower()
            mime = {".jpg": "image/jpeg", ".jpeg": "image/jpeg", ".webp": "image/webp"}.get(ext, "image/png")
            with open(abs_path, "rb") as f:
                return "data:{};base64,{}".format(mime, base64.b64encode(f.read()).decode("ascii"))
        except Exception:
            return None

    def getCrawlLatest(self):
        """Devuelve el nodo de crawl mas reciente (por mtime) de todos los
        paquetes del proyecto, con sus clickables y screenshots. Para el
        live-view del tab Crawl."""
        if not self._project:
            return {"ok": False, "error": "no_project"}
        base = os.path.realpath(self._project)
        best = None
        try:
            for pkg in os.listdir(base):
                nodes_dir = os.path.join(base, pkg, "nodes")
                if not os.path.isdir(nodes_dir):
                    continue
                for fname in os.listdir(nodes_dir):
                    if not fname.endswith(".json"):
                        continue
                    fp = os.path.join(nodes_dir, fname)
                    try:
                        mt = os.path.getmtime(fp)
                    except OSError:
                        continue
                    if best is None or mt > best[0]:
                        best = (mt, pkg, fname[:-5], fp)
        except OSError:
            return {"ok": False, "error": "scan"}
        if not best:
            return {"ok": True, "node": None}
        _mt, pkg, node_id, fp = best
        try:
            with open(fp, "r", encoding="utf-8") as f:
                data = json.load(f)
        except Exception:
            return {"ok": True, "node": None}
        data["pkg"] = pkg
        data["node_id"] = node_id
        return {"ok": True, "node": data}

