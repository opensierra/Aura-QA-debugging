    # ------------------------------------------------------------- proyecto
    def newProject(self, name, path):
        try:
            name = (name or "").strip()
            if not name:
                return {"ok": False, "error": "empty_name"}
            name = re.sub(r'[\\/:*?"<>|]', "_", name)
            base_dir = path if (path and os.path.isdir(path)) else os.path.join(BASE, "Test")
            project_dir = os.path.join(base_dir, name)
            if os.path.exists(project_dir):
                return {"ok": False, "error": "exists", "path": project_dir}
            os.makedirs(project_dir, exist_ok=True)
            if not os.path.isdir(project_dir):
                return {"ok": False, "error": "create_failed", "path": project_dir}
            self._project = project_dir
            self._last_export = None
            self._push_recent(project_dir)
            rel = self._rel_to_base(project_dir)
            return {"ok": True, "project": name, "path": project_dir, "rel": rel}
        except Exception as e:
            return {"ok": False, "error": str(e)}

    def openProject(self, path):
        if os.path.isabs(path):
            project_dir = path
        else:
            project_dir = os.path.join(BASE, "Test", path)
        project_dir = os.path.normpath(project_dir)
        if not os.path.isdir(project_dir):
            self._prune_recent()
            return {"ok": False, "error": "not_found"}
        self._project = project_dir
        self._last_export = None
        self._push_recent(project_dir)
        rel = self._rel_to_base(project_dir)
        return {"ok": True, "project": os.path.basename(project_dir), "path": project_dir, "rel": rel}

