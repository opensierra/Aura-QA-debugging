            except Exception:
                self._docs_window = None
        try:
            self._docs_window = webview.create_window(
                "AURA QA - Documentation",
                os.path.join(BASE, "UI", "doc", "Documentation.html"),
                js_api=self,
                width=1000,
                height=700,
                min_size=(560, 420),
                frameless=True,
                shadow=False,
                easy_drag=False,
            )
            return {"ok": True}
        except Exception as e:
            self._docs_window = None
            return {"ok": False, "error": str(e)}

    def closeDocs(self):
        if self._docs_window is not None:
            try:
                self._docs_window.destroy()
            except Exception:
                pass
            self._docs_window = None
        return {"ok": True}

    def docsMinimize(self):
        if self._docs_window:
            try:
                self._docs_window.minimize()
            except Exception:
                pass
        return {"ok": True}

    def docsMoveBy(self, dx, dy):
        if not self._docs_window:
            return
        try:
            self._docs_window.move(self._docs_window.x + int(dx), self._docs_window.y + int(dy))
        except Exception:
            pass

    def docsMaximize(self):
        if not self._docs_window:
            return {"ok": False}
        try:
            if getattr(self, "_docs_max", False):
                self._docs_window.restore()
                self._docs_max = False
            else:
                self._docs_window.maximize()
                self._docs_max = True
            return {"ok": True}
        except Exception as e:
            return {"ok": False, "error": str(e)}


