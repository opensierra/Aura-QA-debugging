            if isinstance(names, list):
                for n in names:
                    if isinstance(n, str) and n.strip() and n not in all_names:
                        all_names.append(n)
        norm = psdns2._normalize_language(lang or "en")
        base = norm.split("-")[0] if norm != "default" else None

        def first_of(key):
            names = translations.get(key)
            if isinstance(names, list):
                for n in names:
                    if isinstance(n, str) and n.strip():
                        return n
            return None

        for key in [k for k in (norm, base, "default") if k]:
            label = first_of(key)
            if label:
                return label, all_names
        return None, all_names

    def refreshPsdns(self):
        catalog = self._psdns_load_catalog()
        installed = self._psdns_installed()
        serials = _adb_devices()
        serial = serials[0] if serials else None
        if installed is None:
            return {"ok": False, "error": "dut_unavailable",
                    "serial": serial, "catalog": catalog,
                    "installed": None,
                    "catalogPackages": len(catalog)}
        return {"ok": True, "serial": serial, "catalog": catalog,
                "installed": sorted(installed),
                "catalogPackages": len(catalog)}

    def updatePsdns(self, entries=None, refresh=False):
        with self._psdns_lock:
            if self._psdns_task is not None:
                return {"ok": False, "error": "already_running",
                        "taskId": self._psdns_task}
            self._psdns_task_seq += 1
            task_id = "psdns-%d" % self._psdns_task_seq
            self._psdns_task = task_id
        threading.Thread(
            target=self._psdns_update_worker, args=(task_id, entries, refresh),
            daemon=True).start()
        return {"ok": True, "taskId": task_id}

    def _psdns_update_worker(self, task_id, entries, refresh):
        from Customlib import psdns2

        def on_log(message):
            self._psdns_push_event("progress", task_id, message=message)

        psdns2.set_log_callback(on_log)
        try:
            data = psdns2.update_catalog(
                entries=entries if entries is not None else None,
                refresh=bool(refresh),
                languages=["es", "en", "id", "pt", "th", "ur", "vi", "default"],
            )
            self._psdns_push_event("done", task_id,
                                   count=len(data) if isinstance(data, dict) else 0)
        except Exception as e:
            self._psdns_push_event("error", task_id, message=str(e))
        finally:
            psdns2.set_log_callback(None)
            with self._psdns_lock:
                if self._psdns_task == task_id:
                    self._psdns_task = None

    # ------------------------------------------------------------ pipeline
    _pipe_proc = None
    _pipe_lock = threading.Lock()
    _pipe_session = {"start": None, "base_issues": 0, "base_warnings": 0}
    _pipe_state = {
        "status": "idle", "stage": None,
        "current_package": None, "current_item": None,
        "current": 0, "total_items": None,
        "issues": 0, "warnings": 0,
        "started": None, "elapsed": 0,
        "exit_code": None, "error": None, "extOut": None,
        "running": False,
    }

    def _pipe_push(self, js):
        try:
            webview.windows[0].evaluate_js(js)
        except Exception:
            pass

    def _pipe_state_snapshot(self):
        with self._pipe_lock:
            st = dict(self._pipe_state)
            sess_start = self._pipe_session.get("start")
        if sess_start and st["status"] == "running":
            st["elapsed"] = int(time.time() - sess_start)
        return st

    def _pipe_count_issues(self, project_dir):
        issues = warnings = 0
        if not project_dir or not os.path.isdir(project_dir):
            return issues, warnings
        try:
            names = os.listdir(project_dir)
        except OSError:
            return issues, warnings
        for name in names:
            rp = os.path.join(project_dir, name, "qa_report.json")
            if not os.path.isfile(rp):
                continue
            try:
                with open(rp, "r", encoding="utf-8") as f:
                    data = json.load(f)
            except Exception:
                continue
            for p in data.get("paquetes", []):
                for r in p.get("resultados", []):
                    issues += len(r.get("issues", []) or [])
                    warnings += len(r.get("ocr_warnings", []) or [])
        return issues, warnings

    def _pipe_update(self, **kw):
        with self._pipe_lock:
            self._pipe_state.update(kw)
        self._pipe_emit_counters()

    def _pipe_emit_counters(self):
        st = self._pipe_state_snapshot()
        payload = {
            "status": st.get("status", "idle"),
            "stage": st.get("stage"),
            "current": st.get("current", 0),
            "total": st.get("total_items"),
            "issues": st.get("issues", 0),
            "warnings": st.get("warnings", 0),
            "elapsed": st.get("elapsed", 0),
        }
        self._pipe_push("window.onCounters && window.onCounters(%s)" % json.dumps(payload, ensure_ascii=False))

    def _pipe_reader(self, proc):
        for raw in iter(proc.stdout.readline, ""):
            if not raw:
                break
            raw = raw.strip()
            if not raw:
                continue
            try:
                ev = json.loads(raw)
            except Exception:
                self._pipe_push("window.onPipelineLog && window.onPipelineLog({msg: %s, level:'INFO'})"
                                % json.dumps(raw, ensure_ascii=False))
                continue
            etype = ev.get("event")
            if etype == "log":
                self._pipe_push("window.onPipelineLog && window.onPipelineLog({msg: %s, level: %s})" % (
                    json.dumps(ev.get("msg", ""), ensure_ascii=False),
                    json.dumps(ev.get("level", "INFO"))))
            elif etype == "step":
                step = ev.get("step", "")
                state = ev.get("state", "")
                if state == "active":
                    self._pipe_update(stage=step)
                elif state in ("done", "skipped"):
                    if step == "qa":
                        iss, wrn = self._pipe_count_issues(self._pipe_state.get("extOut"))
                        self._pipe_update(issues=iss, warnings=wrn)
                self._pipe_push("window.onPipelineStep && window.onPipelineStep(%s, %s)" % (
                    json.dumps(step), json.dumps(state)))
            elif etype == "progress":
                upd = dict(
                    stage=ev.get("stage"),
                    current=ev.get("current", 0),
                    current_package=ev.get("package"),
                    current_item=ev.get("item"),
                )
                # Tarea 5: nunca pisar con null un total ya conocido.
                if ev.get("total") is not None:
                    upd["total_items"] = ev.get("total")
                if ev.get("issues") is not None:
                    upd["issues"] = ev.get("issues")
                if ev.get("warnings") is not None:
                    upd["warnings"] = ev.get("warnings")
                self._pipe_update(**upd)
                self._pipe_push("window.onPipelineProgress && window.onPipelineProgress(%s)"
                                % json.dumps(ev, ensure_ascii=False))
            elif etype == "done":
                iss, wrn = self._pipe_count_issues(self._pipe_state.get("extOut"))
                self._pipe_update(status="done", issues=iss, warnings=wrn)
                self._pipe_push("window.onPipelineDone && window.onPipelineDone(%s)"
                                % json.dumps(ev, ensure_ascii=False))
            elif etype == "packages":
                self._pipe_push("window.onPipelinePackages && window.onPipelinePackages(%s)"
                                % json.dumps(ev.get("packages", []), ensure_ascii=False))
            elif etype == "error":
                self._pipe_update(status="error", error=ev.get("msg", ""))
                self._pipe_push("window.onPipelineError && window.onPipelineError(%s)"
                                % json.dumps(ev.get("msg", ""), ensure_ascii=False))
        proc.wait()
        with self._pipe_lock:
            code = proc.returncode
            if self._pipe_state["status"] not in ("done", "error", "cancelled"):
                self._pipe_state["status"] = "done" if code == 0 else "error"
            self._pipe_state["exit_code"] = code
            self._pipe_state["running"] = False
            sess_start = self._pipe_session.get("start")
            if sess_start:
                self._pipe_state["elapsed"] = int(time.time() - sess_start)
        self._pipe_emit_counters()
        if code == 0 and "autoexport" in (self._pipe_state.get("stages") or []):
            try:
                from Customlib import qa_export
                proj = self._pipe_state.get("extOut") or self._project
                pair = self._pipe_state.get("pair") or ""
                # Idioma del reporte = target del par de ejecucion (es-vi -> vi).
                # Si no hay par, cae al idioma de la UI.
                exp_lang = pair.split("-")[-1].strip().lower()[:2] or "en"
                if exp_lang not in ("en", "es", "vi", "id", "ur", "pt", "th"):
                    exp_lang = (self._pipe_state.get("exportLang") or "en").strip()[:2] or "en"
                fname = qa_export.safe_filename(os.path.basename(proj), "report")
                res = qa_export.export_xlsx(proj, {"lang": exp_lang, "includeScreenshots": True, "thumbSize": "l"}, proj, fname)
                if res and res.get("ok"):
                    self._last_export = res["path"]
                    self._pipe_push("window.onExportDone && window.onExportDone(%s)"
                                    % json.dumps(res, ensure_ascii=False))
                else:
                    self._pipe_push("window.onExportDone && window.onExportDone(%s)"
                                    % json.dumps({"ok": False, "error": (res or {}).get("error", "export_failed")}, ensure_ascii=False))
            except Exception as e:
                self._pipe_push("window.onExportDone && window.onExportDone(%s)"
                                % json.dumps({"ok": False, "error": "unexpected", "detail": str(e)}, ensure_ascii=False))
        self._pipe_push("window.onPipelineExit && window.onPipelineExit(%d)" % (code or 0))

    def startPipeline(self, cfg):
        with self._pipe_lock:
            if self._pipe_proc and self._pipe_proc.poll() is None:
                return {"ok": False, "error": "already_running"}
            extOut = (cfg.get("extOut") or "").strip()
            if not extOut:
                return {"ok": False, "error": "no_extout"}
            out_dir = extOut if os.path.isabs(extOut) else os.path.join(BASE, extOut)
            try:
                os.makedirs(out_dir, exist_ok=True)
            except Exception as e:
                return {"ok": False, "error": "extout_invalid", "detail": str(e)}
            if not os.access(out_dir, os.W_OK):
                return {"ok": False, "error": "extout_not_writable", "detail": out_dir}
            proj = self._project
            if not (proj and os.path.realpath(proj) == os.path.realpath(out_dir)):
                proj = out_dir
            self._project = proj
            self._prune_recent()
            new_session = bool(cfg.get("newSession", True))
            if new_session:
                self._pipe_session = {"start": time.time()}
                base_issues = 0
                base_warnings = 0
            else:
                if self._pipe_session.get("start") is None:
                    self._pipe_session["start"] = time.time()
                base_issues = self._pipe_state.get("issues", 0) or 0
                base_warnings = self._pipe_state.get("warnings", 0) or 0
            sess_start = self._pipe_session["start"]
            self._pipe_state = {
                "status": "running", "stage": None,
                "current_package": None, "current_item": None,
                "current": 0, "total_items": None,
                "issues": base_issues, "warnings": base_warnings,
                "started": sess_start, "elapsed": int(time.time() - sess_start),
                "exit_code": None, "error": None,
                "extOut": out_dir,
                "stages": cfg.get("stages") or [],
                "pair": (cfg.get("pair") or "").strip(),
                "exportLang": (cfg.get("exportLang") or "en").strip() or "en",
                "running": True,
            }
            flags = subprocess.CREATE_NO_WINDOW if os.name == "nt" else 0
            # Bug codificación: el hijo heredaba cp1252 en stdout y el padre lee
            # la pipe como UTF-8 -> acentos se convertían en U+FFFD y CJK/Thai/
            # Urdu se perdían (UnicodeEncodeError silenciado). Forzar UTF-8 en el
            # hijo para que coincida con encoding="utf-8" del padre.
            env = {**os.environ, "PYTHONIOENCODING": "utf-8"}
            try:
                self._pipe_proc = subprocess.Popen(
                    [sys.executable, os.path.join(BASE, "run_pipeline.py"),
                     json.dumps(cfg, ensure_ascii=True)],
                    stdout=subprocess.PIPE, stderr=subprocess.STDOUT, cwd=BASE,
                    creationflags=flags, encoding="utf-8", errors="replace",
                    env=env,
                )
            except Exception as e:
                self._pipe_state["status"] = "idle"
                return {"ok": False, "error": str(e)}
        threading.Thread(target=self._pipe_reader, args=(self._pipe_proc,), daemon=True).start()
        self._pipe_emit_counters()
        return {"ok": True, "extOut": out_dir}

    def stopPipeline(self):
        with self._pipe_lock:
            proc = self._pipe_proc
            if proc and proc.poll() is None:
                self._pipe_state["status"] = "cancelled"
                self._pipe_state["error"] = "cancelled by user"
        if proc and proc.poll() is None:
            try:
                if os.name == "nt":
                    subprocess.run(["taskkill", "/F", "/T", "/PID", str(proc.pid)],
                                   capture_output=True, timeout=10)
                else:
                    proc.terminate()
            except Exception:
                pass
            try:
                proc.wait(timeout=5)
            except Exception:
                try:
                    proc.kill()
                except Exception:
                    pass
        self._pipe_emit_counters()
        return {"ok": True}

    def getPipelineState(self):
        st = self._pipe_state_snapshot()
        self._pipe_emit_counters()
        return st

    # ------------------------------------------------- start from screenshot
    _ss_copy_lock = threading.Lock()
    _ss_copy_seq = 0
    _ss_img_exts = (".png", ".jpg", ".jpeg")

    def _ss_build_index(self, unstructure):
        """Genera <unstructure>/screenshots.index: una linea por imagen
        (ruta relativa con separador /), ordenada, escritura atomica.
        Escanea TODO unstructure/ (puede acumular varias carpetas copiadas)."""
        entries = []
        for root, _dirs, names in os.walk(unstructure):
            for n in names:
                if n.lower().endswith(self._ss_img_exts):
                    rel = os.path.relpath(os.path.join(root, n), unstructure)
                    entries.append(rel.replace(os.sep, "/"))
        entries.sort()
        index_path = os.path.join(unstructure, "screenshots.index")
        tmp_path = index_path + ".tmp"
        with open(tmp_path, "w", encoding="utf-8") as f:
            for e in entries:
                f.write(e + "\n")
        os.replace(tmp_path, index_path)
        return len(entries)

    def _ss_copy_emit(self, seq, kind, **extra):
        payload = {"seq": seq, "kind": kind}
        payload.update(extra)
        try:
            js = "window.onScreenshotCopy && window.onScreenshotCopy(%s)" % json.dumps(
                payload, ensure_ascii=False)
            webview.windows[0].evaluate_js(js)
        except Exception:
            pass

    def copyToUnstructure(self, src, dest):
        """Copia la carpeta de screenshots elegida dentro de <dest>/unstructure
        en un hilo en segundo plano, emitiendo eventos de progreso a la UI
        (window.onScreenshotCopy). Devuelve de inmediato {ok, seq} para que la
        UI pueda bloquear el inicio hasta el evento 'done'."""
        with self._ss_copy_lock:
            self._ss_copy_seq += 1
            seq = self._ss_copy_seq
        # Capturar los valores ANTES de definir worker: si dentro se
        # reasignaran src/dest, Python las trataria como locales y el read
        # previo lanzaria UnboundLocalError.
        src_raw = str(src or "").strip()
        dest_raw = str(dest or "").strip()

        def worker():
            try:
                dest_p = os.path.normpath(dest_raw)
                if not dest_p or not os.path.isdir(dest_p):
                    self._ss_copy_emit(seq, "error", code="dest_invalid", detail=dest_p)
                    return
                src_p = os.path.normpath(src_raw)
                if not src_p:
                    self._ss_copy_emit(seq, "error", code="src_invalid", detail=src_p)
                    return
                # Si la UI envia una ruta relativa (p. ej. "unstructure\vivo"
                # tras una copia previa), se resuelve contra el proyecto.
                if not os.path.isabs(src_p):
                    src_p = os.path.join(dest_p, src_p)
                if not os.path.isdir(src_p):
                    self._ss_copy_emit(seq, "error", code="src_invalid", detail=src_p)
                    return
                unstructure = os.path.join(dest_p, "unstructure")
                os.makedirs(unstructure, exist_ok=True)
                target = os.path.join(unstructure, os.path.basename(src_p.rstrip("\\/")))
                # Si la fuente ya ES la copia (re-copiar la ruta relativa que
                # quedo en el campo), no hay nada que hacer: no borrar ni copiar.
                if os.path.normpath(src_p) == os.path.normpath(target):
                    self._ss_build_index(unstructure)
                    self._ss_copy_emit(seq, "done", path=os.path.relpath(target, dest_p))
                    return
                if os.path.exists(target):
                    if os.path.isdir(target) and not os.path.islink(target):
                        shutil.rmtree(target)
                    else:
                        os.remove(target)
                files = []
                for root, _dirs, names in os.walk(src_p):
                    for n in names:
                        files.append(os.path.join(root, n))
                total = len(files)
                done = 0
                for f in files:
                    rel = os.path.relpath(f, src_p)
                    dst = os.path.join(target, rel)
                    os.makedirs(os.path.dirname(dst), exist_ok=True)
                    shutil.copy2(f, dst)
                    done += 1
                    self._ss_copy_emit(seq, "progress", done=done, total=total,
                                       name=os.path.basename(f))
                self._ss_build_index(unstructure)
                self._ss_copy_emit(seq, "done", path=os.path.relpath(target, dest_p))
            except Exception as e:
                self._ss_copy_emit(seq, "error", code="copy_failed", detail=str(e))

        threading.Thread(target=worker, daemon=True).start()
        return {"ok": True, "seq": seq}

    # ------------------------------------------------------------ ventana
    def minimize(self):
        if self._window:
            self._window.minimize()

    def maximize(self):
        if not self._window:
            return
        # Consulta el estado real de la ventana (IsZoomed) en vez de confiar
        # en la bandera: la ventana se crea ya maximizada pero _is_max nace
        # en False, lo que desincronizaba el primer clic.
        try:
            import ctypes
            from ctypes import wintypes
            user32 = ctypes.windll.user32
            hwnd = self._window.native.Handle.ToInt64()
            if user32.IsZoomed(hwnd):
                self._window.restore()
                self._is_max = False
            else:
                self._window.maximize()
                self._is_max = True
        except Exception:
            if getattr(self, "_is_max", False):
                self._window.restore()
                self._is_max = False
            else:
                self._window.maximize()
                self._is_max = True

    _closing = False

    def _cleanup_once(self):
        if self._closing:
            return
        self._closing = True
        try:
            self.stopPipeline()
        except Exception:
            pass
        try:
            self.stopBlueCode()
        except Exception:
            pass

    def close(self):
        threading.Thread(target=self._cleanup_once, daemon=True).start()
        if self._window:
            self._window.destroy()

    def moveBy(self, dx, dy):
        if not self._window:
            return
        try:
            self._window.move(self._window.x + int(dx), self._window.y + int(dy))
        except Exception:
            pass

    def appReady(self):
        # El frontend termino su inicializacion esencial: escribe la senal que
        # el launcher esta esperando. La ventana NO se muestra aqui: el launcher
        # destruye el splash primero y despues envia la orden de mostrar.
        if self._ready:
            return {"ok": True}
        self._ready = True
        try:
            import tempfile
            sig = os.path.join(tempfile.gettempdir(), "aura_ready_%d.txt" % os.getpid())
            with open(sig, "w") as f:
                f.write("1")
            threading.Thread(target=self._wait_show_signal, daemon=True).start()
        except Exception:
            pass
        return {"ok": True}

    def _wait_show_signal(self):
        # Espera la orden del launcher (aura_show_<pid>.txt) para mostrar la
        # ventana. Fallback: si el launcher muere y no llega en 10s, se muestra
        # igual para no dejar la app invisible.
        import tempfile
        import time
        show = os.path.join(tempfile.gettempdir(), "aura_show_%d.txt" % os.getpid())
        deadline = time.time() + 10
        while time.time() < deadline:
            if os.path.exists(show):
                break
            time.sleep(0.05)
        try:
            os.remove(show)
        except Exception:
            pass
        self._fix_maximized_position()
        if self._window:
            try:
                self._window.show()
            except Exception:
                pass

    def _fix_maximized_position(self):
        # Las ventanas frameless maximizadas se posicionan a los bounds del
        # monitor (cubren la taskbar). Hook de WM_GETMINMAXINFO para que se
        # maximizen al work area. Se instala antes de maximizar.
        try:
            import ctypes
            from ctypes import wintypes
            user32 = ctypes.windll.user32
            # native.Handle es un IntPtr de .NET; se convierte a int de Python.
            hwnd = self._window.native.Handle.ToInt64()
            MONITOR_DEFAULTTONEAREST = 2
            class POINT(ctypes.Structure):
                _fields_ = [("x", wintypes.LONG), ("y", wintypes.LONG)]
            class MINMAXINFO(ctypes.Structure):
                _fields_ = [("ptReserved", POINT), ("ptMaxSize", POINT),
                            ("ptMaxPosition", POINT), ("ptMinTrackSize", POINT),
                            ("ptMaxTrackSize", POINT)]
            class MONITORINFO(ctypes.Structure):
                _fields_ = [("cbSize", wintypes.DWORD),
                            ("rcMonitor", wintypes.RECT),
                            ("rcWork", wintypes.RECT),
                            ("dwFlags", wintypes.DWORD)]
            WM_GETMINMAXINFO = 0x0024
            GWLP_WNDPROC = -4
            # Tipos correctos para 64-bit (evita truncar punteros a 32 bits).
            user32.GetWindowLongPtrW.restype = ctypes.c_void_p
            user32.GetWindowLongPtrW.argtypes = [wintypes.HWND, ctypes.c_int]
            user32.SetWindowLongPtrW.restype = ctypes.c_void_p
            user32.SetWindowLongPtrW.argtypes = [wintypes.HWND, ctypes.c_int, ctypes.c_void_p]
            user32.CallWindowProcW.restype = ctypes.c_ssize_t
            user32.CallWindowProcW.argtypes = [ctypes.c_void_p, wintypes.HWND,
                                               wintypes.UINT, ctypes.c_size_t,
                                               ctypes.c_ssize_t]
            WNDPROC = ctypes.WINFUNCTYPE(ctypes.c_ssize_t, wintypes.HWND,
                                         wintypes.UINT, ctypes.c_size_t,
                                         ctypes.c_ssize_t)
            orig = user32.GetWindowLongPtrW(hwnd, GWLP_WNDPROC)
            def _hook(h, msg, wp, lp):
                if msg == WM_GETMINMAXINFO:
                    mmi = ctypes.cast(lp, ctypes.POINTER(MINMAXINFO)).contents
                    mi = MONITORINFO(); mi.cbSize = ctypes.sizeof(MONITORINFO)
                    hmon = user32.MonitorFromWindow(h, MONITOR_DEFAULTTONEAREST)
                    if user32.GetMonitorInfoW(hmon, ctypes.byref(mi)):
                        r = mi.rcWork
                        mmi.ptMaxSize.x = r.right - r.left
                        mmi.ptMaxSize.y = r.bottom - r.top
                        mmi.ptMaxPosition.x = r.left
                        mmi.ptMaxPosition.y = r.top
                return user32.CallWindowProcW(orig, h, msg, wp, lp)
            # Se guarda la referencia para que no se recoja el callback.
            self._wndproc_hook = WNDPROC(_hook)
            user32.SetWindowLongPtrW(hwnd, GWLP_WNDPROC, self._wndproc_hook)
            # La ventana se creo ya maximizada (sin hook, a los bounds del
            # monitor). Restore -> maximize re-dispara WM_GETMINMAXINFO con el
            # hook activo, recolocandola al work area. La ventana sigue oculta,
            # asi que no hay flicker visible.
            self._window.restore()
            self._window.maximize()
        except Exception:
            pass

