_NO_WINDOW = getattr(subprocess, "CREATE_NO_WINDOW", 0) if os.name == "nt" else 0


def _run(cmd, timeout=5):
    return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout,
                          creationflags=_NO_WINDOW)


def _adb_shell(prop, serial=None):
    cmd = ["adb"] + (["-s", serial] if serial else []) + ["shell", "getprop", prop]
    try:
        return _run(cmd).stdout.strip()
    except Exception:
        return ""


def _adb_devices():
    try:
        out = []
        for line in _run(["adb", "devices"]).stdout.strip().splitlines():
            parts = line.split()
            if len(parts) >= 2 and parts[1] == "device":
                out.append(parts[0])
        return out
    except Exception:
        return []


def _adb_wm(serial, what, label):
    try:
        for line in _run(["adb", "-s", serial, "shell", "wm", what]).stdout.strip().splitlines():
            if label in line:
                return line.split(":")[-1].strip()
    except Exception:
        pass
    return None


def _http_alive(url, timeout=1.5):
    import urllib.request
    import urllib.error
    try:
        urllib.request.urlopen(url, timeout=timeout).close()
        return True
    except urllib.error.HTTPError:
        return True
    except Exception:
        return False


