    # ------------------------------------------------------------ recientes
    def _load_recent(self):
        self._recent_loaded = True
        self._recent = []
        try:
            with open(RECENT_PATH, "r", encoding="utf-8") as f:
                data = json.load(f)
        except Exception:
            return
        if not isinstance(data, list):
            return
        for x in data:
            x = str(x)
            if not os.path.isabs(x):
                x = os.path.join(BASE, "Test", x)
            x = os.path.normpath(x)
            if x not in self._recent:
                self._recent.append(x)

    def _save_recent(self):
        try:
            os.makedirs(os.path.dirname(RECENT_PATH), exist_ok=True)
            tmp = RECENT_PATH + ".tmp"
            with open(tmp, "w", encoding="utf-8") as f:
                json.dump(self._recent[:10], f, ensure_ascii=False, indent=2)
            os.replace(tmp, RECENT_PATH)
        except Exception:
            pass

    def _prune_recent(self):
        """Tarea 2: elimina de recent.json las rutas que ya no existen."""
        if not self._recent_loaded:
            self._load_recent()
        alive = [p for p in self._recent if os.path.isdir(p)]
        if len(alive) != len(self._recent):
            self._recent = alive
            self._save_recent()

    def _push_recent(self, path):
        if not self._recent_loaded:
            self._load_recent()
        path = os.path.normpath(path)
        if path in self._recent:
            self._recent.remove(path)
        self._recent.insert(0, path)
        self._recent = self._recent[:10]
        self._save_recent()

    def getRecentProjects(self):
        self._prune_recent()
        out = []
        for p in self._recent:
            try:
                mtime = os.path.getmtime(p)
            except OSError:
                mtime = None
            out.append({"name": os.path.basename(p) or p, "path": p, "mtime": mtime})
        return out

    def removeRecentProject(self, path):
        if not self._recent_loaded:
            self._load_recent()
        path = os.path.normpath(path)
        if path in self._recent:
            self._recent.remove(path)
            self._save_recent()
            return True
        return False

    # ------------------------------------------------------------- BlueCode
    def _bc_register_project(self):
        import urllib.request
        import urllib.parse
        url = self._bc_url
        if not url:
            return
        try:
            enc = urllib.parse.quote(BASE, safe="")
            req = urllib.request.Request(
                "{}/project/current?directory={}".format(url, enc),
                headers={"Accept": "application/json"},
            )
            urllib.request.urlopen(req, timeout=5).close()
            self._bc_project = True
        except Exception:
            pass

    def _bc_scan(self):
        try:
            with open(self._bc_log, "r", encoding="utf-8", errors="replace") as f:
                content = _ANSI.sub("", f.read())
            host = re.search(r'hostname:\s*"([^"]+)"', content)
            port = re.search(r'port:\s*(\d+)', content)
            if host and port:
                with self._bc_lock:
                    self._bc_url = "http://{}:{}".format(host.group(1), port.group(1))
        except Exception:
            pass

    def _bc_tail(self, n=500):
        try:
            with open(self._bc_log, "r", encoding="utf-8", errors="replace") as f:
                return _ANSI.sub("", f.read())[-n:].strip()
        except Exception:
            return ""

    def _bc_exe(self):
        import shutil
        shim = shutil.which("bluecode")
        if not shim:
            return None
        try:
            with open(shim, encoding="utf-8", errors="replace") as f:
                for line in f:
                    m = re.search(r"cmd-shim-target=(\S+)", line)
                    if m:
                        return m.group(1).replace("/", os.sep)
        except Exception:
            pass
        return None

    def startBlueCode(self):
        with self._bc_lock:
            if self._bc_proc and self._bc_proc.poll() is None:
                return {"ok": True, "already": True}
            self._bc_url = None
            self._bc_project = False
            try:
                os.remove(self._bc_log)
            except OSError:
                pass
            try:
                log = open(self._bc_log, "w", encoding="utf-8")
            except OSError as e:
                return {"ok": False, "error": str(e)}
            exe = self._bc_exe()
            env = os.environ.copy()
            kwargs = dict(stdout=log, stderr=subprocess.STDOUT, cwd=BASE)
            if os.name == "nt":
                kwargs["creationflags"] = _NO_WINDOW
            else:
                kwargs["start_new_session"] = True
            try:
                if exe:
                    noop = os.path.join(BASE, ".bc_noop.bat")
                    if not os.path.isfile(noop):
                        with open(noop, "w") as f:
                            f.write("@exit /b 0\r\n")
                    env["ComSpec"] = noop
                    env["BROWSER"] = os.path.join(BASE, ".bc_noop.bat")
                    self._bc_proc = subprocess.Popen([exe, "serve"], env=env, **kwargs)
                else:
                    self._bc_proc = subprocess.Popen("bluecode serve", shell=True, env=env, **kwargs)
            except Exception as e:
                self._bc_proc = None
                return {"ok": False, "error": str(e)}
            finally:
                log.close()
            return {"ok": True}

    def getBlueCodeStatus(self):
        with self._bc_lock:
            proc = self._bc_proc
        if proc is None:
            return {"state": "idle"}
        rc = proc.poll()
        if rc is not None:
            return {"state": "exited", "code": rc, "log": self._bc_tail()}
        self._bc_scan()
        with self._bc_lock:
            url = self._bc_url
        if not url:
            return {"state": "starting", "stage": "launch"}
        if not _http_alive(url):
            return {"state": "starting", "stage": "wait_http"}
        if not self._bc_project:
            self._bc_register_project()
        import urllib.parse
        return {"state": "ready", "url": "{}/{}/session".format(url, urllib.parse.quote(BASE, safe=""))}

    def getBlueCodeUrl(self):
        st = self.getBlueCodeStatus()
        return {"url": st.get("url") if st.get("state") == "ready" else None}

    def stopBlueCode(self):
        with self._bc_lock:
            proc = self._bc_proc
            self._bc_proc = None
            self._bc_url = None
            self._bc_project = False
        if proc and proc.poll() is None:
            try:
                if os.name == "nt":
                    _run(["taskkill", "/F", "/T", "/PID", str(proc.pid)], timeout=10)
                else:
                    import signal
                    os.killpg(os.getpgid(proc.pid), signal.SIGTERM)
            except Exception:
                try:
                    proc.terminate()
                except Exception:
                    pass
            try:
                proc.wait(timeout=5)
            except Exception:
                try:
                    proc.kill()
                except Exception:
                    pass

