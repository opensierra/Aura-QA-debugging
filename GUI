    # ------------------------------------------------------------- device
    def getDeviceInfo(self):
        serials = _adb_devices()
        if not serials:
            self._dev_cache.clear()
            return {"connected": False}
        serial = serials[0]
        now = time.time()
        entry = self._dev_cache.get(serial)
        if not entry or now - entry["t"] > 60 or not entry["info"].get("model"):
            info = {
                "serial": serial,
                "model": _adb_shell("ro.product.model", serial),
                "release": _adb_shell("ro.build.version.release", serial),
                "build_id": _adb_shell("ro.build.display.id", serial),
                "resolution": _adb_wm(serial, "size", "Physical size"),
                "density": _adb_wm(serial, "density", "Physical density"),
            }
            entry = self._dev_cache[serial] = {"t": now, "info": info}
        out = dict(entry["info"])
        out["connected"] = True
        out["language"] = _adb_shell("persist.sys.locale", serial) or _adb_shell("ro.product.locale", serial)
        return out

